generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
  engineType    = "library"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                      String                @id @default(cuid())
  name                    String?
  email                   String                @unique
  emailVerified           DateTime?
  image                   String?
  password                String?
  notifyNewBenefit        Boolean               @default(false)
  notifyBenefitExpiration Boolean               @default(false)
  notifyExpirationDays    Int                   @default(7)
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  notifyPointsExpiration  Boolean?              @default(true)
  pointsExpirationDays    Int?                  @default(30)
  role                    UserRole              @default(USER)
  subscriptionTier        SubscriptionTier      @default(FREE)
  isBetaUser              Boolean               @default(false)
  betaEnrolledAt          DateTime?
  emailAlertsUsed         Int                   @default(0)
  emailAlertsResetAt      DateTime?
  accounts                Account[]
  benefitStatuses         BenefitStatus[]
  cardEvents              CreditCardEvent[]
  creditCards             CreditCard[]
  loyaltyAccounts         LoyaltyAccount[]
  loyaltyCertificates     LoyaltyCertificate[]
  searchAnalytics         SearchAnalytics[]
  sessions                Session[]
  standaloneBenefits      Benefit[] // Custom benefits not tied to a card
  externalCardMappings                   ExternalCardMapping[]
  amexSyncAttempts                       AmexSyncAttempt[]
  catalogMigrationLedger                 CatalogMigrationLedger[]
  globalBenefitCategoryRepairs           GlobalBenefitCategoryRepair[]           @relation("CategoryRepairOwner")
  globalBenefitCategoryRepairOccurrences GlobalBenefitCategoryRepairOccurrence[] @relation("CategoryRepairOccurrenceOwner")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SearchAnalytics {
  id          String   @id @default(cuid())
  query       String
  resultCount Int      @default(0)
  searchTime  Int      @default(0)
  userId      String?
  createdAt   DateTime @default(now())
  ipAddress   String?
  userAgent   String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([query])
  @@index([createdAt])
  @@index([userId])
}

model CreditCard {
  id                  String                @id @default(cuid())
  name                String
  issuer              String
  cardNumber          String?
  expiryDate          DateTime?
  openedDate          DateTime?
  userId              String
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  lastFourDigits      String?
  nickname            String?
  lifecycleStatus     CardLifecycleStatus   @default(ACTIVE)
  closedDate          DateTime?
  annualFeeAmount     Float?
  annualFeeDueDate    DateTime?
  signupBonusDeadline DateTime?
  spendDeadline       DateTime?
  productChangedFrom  String?
  productChangedTo    String?
  lifecycleNotes      String?
  productKey          String?
  predefinedCardId    String?
  benefits            Benefit[]
  benefitStatuses     BenefitStatus[]
  events              CreditCardEvent[]
  externalMappings    ExternalCardMapping[]
  syncRowAudits                    AmexSyncRowAudit[]
  catalogMigrations                CatalogMigrationLedger[]
  globalBenefitCategoryRepairs     GlobalBenefitCategoryRepair[]           @relation("CategoryRepairCreditCard")
  categoryRepairOccurrenceEvidence GlobalBenefitCategoryRepairOccurrence[] @relation("CategoryRepairOccurrenceCreditCard")
  predefinedCard                   PredefinedCard?                          @relation(fields: [predefinedCardId], references: [id], onDelete: Restrict)
  user                User                  @relation(fields: [userId], references: [id])

  @@index([userId, productKey, lastFourDigits])
  @@index([predefinedCardId])
}

model CreditCardEvent {
  id           String        @id @default(cuid())
  creditCardId String
  userId       String
  eventType    CardEventType
  eventDate    DateTime
  description  String
  metadata     Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  creditCard   CreditCard    @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([creditCardId, eventDate])
  @@index([userId, eventDate])
}

model Benefit {
  id                       String                 @id @default(cuid())
  category                 String
  description              String
  percentage               Float
  maxAmount                Float?
  startDate                DateTime
  endDate                  DateTime?
  frequency                BenefitFrequency       @default(ONE_TIME)
  creditCardId             String? // Optional: null for standalone benefits
  userId                   String? // For standalone benefits not tied to a card
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  cycleAlignment           BenefitCycleAlignment? @default(CARD_ANNIVERSARY)
  fixedCycleDurationMonths Int?
  fixedCycleStartMonth     Int?
  occurrencesInCycle       Int                    @default(1)
  productKey               String?
  creditFamilyKey          String?
  periodKey                String?
  creditCard               CreditCard?            @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  user                     User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  benefitStatuses          BenefitStatus[]
  syncRowAudits            AmexSyncRowAudit[]
  categoryRepair           GlobalBenefitCategoryRepair? @relation("CategoryRepairLegacyBenefit")

  @@index([creditCardId, productKey, creditFamilyKey, periodKey])
}

model PredefinedCard {
  id                String                   @id @default(cuid())
  catalogKey        String?                  @unique
  name              String                   @unique
  issuer            String
  annualFee         Float
  imageUrl          String?
  productKey        String?                  @unique
  retiredAt         DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  benefits                     PredefinedBenefit[]
  creditCards                  CreditCard[]
  catalogMigrations            CatalogMigrationLedger[]
  globalBenefitCategoryRepairs GlobalBenefitCategoryRepair[] @relation("CategoryRepairPredefinedCard")
}

model PredefinedBenefit {
  id                       String                 @id @default(cuid())
  catalogKey               String?                @unique
  category                 String
  description              String
  percentage               Float
  maxAmount                Float?
  frequency                BenefitFrequency       @default(ONE_TIME)
  predefinedCardId         String
  retiredAt                DateTime?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  cycleAlignment           BenefitCycleAlignment? @default(CARD_ANNIVERSARY)
  fixedCycleDurationMonths Int?
  fixedCycleStartMonth     Int?
  occurrencesInCycle       Int                    @default(1)
  productKey               String?
  creditFamilyKey          String?
  periodKey                String?
  usageWayId               String?
  predefinedCard           PredefinedCard         @relation(fields: [predefinedCardId], references: [id], onDelete: Restrict)
  usageWay                 BenefitUsageWay?       @relation(fields: [usageWayId], references: [id])
  benefitStatuses          BenefitStatus[]
  catalogMigrations                CatalogMigrationLedger[]
  syncRowAudits                    AmexSyncRowAudit[]
  globalBenefitCategoryRepairs     GlobalBenefitCategoryRepair[]           @relation("CategoryRepairPredefinedBenefit")
  categoryRepairOccurrenceEvidence GlobalBenefitCategoryRepairOccurrence[] @relation("CategoryRepairOccurrencePredefinedBenefit")

  @@index([predefinedCardId, retiredAt])
  @@index([productKey, creditFamilyKey, periodKey])
}

model BenefitUsageWay {
  id                 String              @id @default(cuid())
  title              String
  slug               String              @unique
  description        String?
  content            String
  category           String?
  tips               String[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  predefinedBenefits PredefinedBenefit[]
}

model BenefitStatus {
  id                       String                          @id @default(cuid())
  benefitId                String?
  creditCardId             String?
  predefinedBenefitId      String?
  userId                   String
  cycleStartDate           DateTime
  cycleEndDate             DateTime
  isCompleted              Boolean                         @default(false)
  completedAt              DateTime?
  isNotUsable              Boolean                         @default(false)
  usedAmount               Float                           @default(0) // Track partial/full amount used
  createdAt                DateTime                        @default(now())
  updatedAt                DateTime                        @updatedAt
  orderIndex               Int?
  occurrenceIndex          Int                             @default(0)
  benefit                  Benefit?                        @relation(fields: [benefitId], references: [id], onDelete: Cascade)
  creditCard               CreditCard?                     @relation(fields: [creditCardId], references: [id], onDelete: Restrict)
  predefinedBenefit        PredefinedBenefit?              @relation(fields: [predefinedBenefitId], references: [id], onDelete: Restrict)
  user                     User                            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceProvenance                 BenefitStatusSourceProvenance[]
  syncRowAudits                    AmexSyncRowAudit[]
  categoryRepairKeeperEvidence     GlobalBenefitCategoryRepairOccurrence? @relation("CategoryRepairKeeperStatus")

  @@unique([benefitId, userId, cycleStartDate, occurrenceIndex], map: "BenefitStatus_custom_occurrence_key")
  @@index([creditCardId, predefinedBenefitId, userId, cycleStartDate, occurrenceIndex], map: "BenefitStatus_standard_occurrence_lookup_idx")
  @@index([userId, orderIndex, cycleEndDate], map: "BenefitStatus_dashboard_user_order_end_idx")
  @@index([userId, cycleEndDate], map: "BenefitStatus_dashboard_user_end_idx")
  @@index([userId, isCompleted, isNotUsable, cycleEndDate], map: "BenefitStatus_dashboard_user_state_end_idx")
}

model ExternalCardMapping {
  id                String                  @id @default(cuid())
  userId            String
  source            ExternalSyncSource
  sourceLocalCardId String
  creditCardId      String
  sourceProductKey  String
  endingSnapshot    String?
  kind              ExternalCardMappingKind @default(MANUAL_CONFIRMED)
  inactiveAt        DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  creditCard        CreditCard              @relation(fields: [creditCardId], references: [id], onDelete: Cascade)

  @@unique([userId, source, sourceLocalCardId])
  @@index([creditCardId])
}

model AmexSyncAttempt {
  id               String                          @id @default(cuid())
  userId           String
  idempotencyKey   String
  envelopeDigest   String
  mode             AmexSyncAttemptMode
  state            AmexSyncAttemptState            @default(PROCESSING)
  confirmedAt      DateTime
  completedAt      DateTime?
  expiresAt        DateTime
  updatedCount     Int                             @default(0)
  unchangedCount   Int                             @default(0)
  skippedCount     Int                             @default(0)
  failedCount      Int                             @default(0)
  createdAt        DateTime                        @default(now())
  updatedAt        DateTime                        @updatedAt
  user             User                            @relation(fields: [userId], references: [id], onDelete: Cascade)
  rowAudits        AmexSyncRowAudit[]
  sourceProvenance BenefitStatusSourceProvenance[]

  @@unique([userId, idempotencyKey])
  @@index([createdAt])
}

model BenefitStatusSourceProvenance {
  id                        String             @id @default(cuid())
  benefitStatusId           String
  source                    ExternalSyncSource
  sourceObservationIdentity String
  sourceObservationDigest   String
  observedAt                DateTime
  contractVersion           String
  parserVersion             String
  productKey                String
  creditFamilyKey           String
  periodKey                 String
  appliedAt                 DateTime           @default(now())
  attemptId                 String?
  benefitStatus             BenefitStatus      @relation(fields: [benefitStatusId], references: [id], onDelete: Cascade)
  attempt                   AmexSyncAttempt?   @relation(fields: [attemptId], references: [id], onDelete: SetNull)

  @@unique([benefitStatusId, source])
  @@index([attemptId])
}

model AmexSyncRowAudit {
  id                        String              @id @default(cuid())
  attemptId                 String
  sourceRowIdentity         String
  sourceObservationIdentity String
  observedAt                DateTime
  contractVersion           String
  parserVersion             String
  disposition               AmexSyncDisposition
  reasonCode                String
  destinationCardId         String?
  destinationBenefitId           String?
  destinationPredefinedBenefitId String?
  destinationDefinitionFingerprint String?
  destinationStatusId            String?
  beforeUsedAmount          Float?
  afterUsedAmount           Float?
  beforeIsCompleted         Boolean?
  afterIsCompleted          Boolean?
  beforeCompletedAt         DateTime?
  afterCompletedAt          DateTime?
  beforeIsNotUsable         Boolean?
  afterIsNotUsable          Boolean?
  createdAt                 DateTime            @default(now())
  attempt                   AmexSyncAttempt     @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  destinationCard           CreditCard?         @relation(fields: [destinationCardId], references: [id], onDelete: SetNull)
  destinationBenefit           Benefit?            @relation(fields: [destinationBenefitId], references: [id], onDelete: SetNull)
  destinationPredefinedBenefit PredefinedBenefit?  @relation(fields: [destinationPredefinedBenefitId], references: [id], onDelete: Restrict)
  destinationStatus            BenefitStatus?      @relation(fields: [destinationStatusId], references: [id], onDelete: SetNull)

  @@unique([attemptId, sourceRowIdentity])
  @@index([createdAt])
  @@index([destinationStatusId])
  @@index([destinationPredefinedBenefitId])
}

model CatalogMigrationLedger {
  id                     String                         @id @default(cuid())
  legacyBenefitId        String                         @unique
  userId                 String
  creditCardId           String?
  predefinedCardId       String?
  predefinedBenefitId    String?
  classification         CatalogMigrationClassification
  phase                  CatalogMigrationPhase          @default(CLASSIFIED)
  sourceFingerprint      String
  destinationFingerprint String?
  classifiedAt           DateTime                       @default(now())
  bridgedAt              DateTime?
  cleanedAt              DateTime?
  rolledBackAt           DateTime?
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt
  user                   User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  creditCard             CreditCard?                    @relation(fields: [creditCardId], references: [id], onDelete: Restrict)
  predefinedCard         PredefinedCard?                @relation(fields: [predefinedCardId], references: [id], onDelete: Restrict)
  predefinedBenefit      PredefinedBenefit?             @relation(fields: [predefinedBenefitId], references: [id], onDelete: Restrict)
  categoryRepair         GlobalBenefitCategoryRepair?   @relation("CategoryRepairMigrationLedger")

  @@index([userId, phase])
  @@index([creditCardId])
  @@index([predefinedBenefitId])
}

model GlobalBenefitCategoryRepair {
  id                                  String                           @id @default(cuid())
  legacyBenefitId                     String                           @unique
  catalogMigrationLedgerId            String                           @unique(map: "GBCategoryRepair_ledgerId_key")
  userId                              String
  creditCardId                        String
  predefinedCardId                    String
  predefinedBenefitId                 String
  targetPredefinedCardCatalogKey      String
  targetPredefinedBenefitCatalogKey   String
  definitionFingerprint               String
  inventoryFingerprint                String
  graphFingerprint                    String
  reviewedCurrentGraphFingerprint     String
  destinationFingerprint              String
  manifestFingerprint                 String
  manifestEntryFingerprint            String
  planFingerprint                     String
  postimageFingerprint                String
  evidenceVersion                     Int                              @default(1)
  phase                               GlobalBenefitCategoryRepairPhase @default(APPLIED)
  appliedAt                           DateTime                         @default(now())
  rolledBackAt                        DateTime?
  createdAt                           DateTime                         @default(now())
  updatedAt                           DateTime                         @updatedAt
  legacyBenefit                       Benefit                          @relation("CategoryRepairLegacyBenefit", fields: [legacyBenefitId], references: [id], onDelete: Cascade, map: "GBCategoryRepair_legacyBenefit_fkey")
  catalogMigrationLedger              CatalogMigrationLedger           @relation("CategoryRepairMigrationLedger", fields: [catalogMigrationLedgerId], references: [id], onDelete: Cascade, map: "GBCategoryRepair_ledger_fkey")
  user                                User                             @relation("CategoryRepairOwner", fields: [userId], references: [id], onDelete: Cascade, map: "GBCategoryRepair_user_fkey")
  creditCard                          CreditCard                       @relation("CategoryRepairCreditCard", fields: [creditCardId], references: [id], onDelete: Cascade, map: "GBCategoryRepair_card_fkey")
  predefinedCard                      PredefinedCard                   @relation("CategoryRepairPredefinedCard", fields: [predefinedCardId], references: [id], onDelete: Restrict, map: "GBCategoryRepair_predefinedCard_fkey")
  predefinedBenefit                   PredefinedBenefit                @relation("CategoryRepairPredefinedBenefit", fields: [predefinedBenefitId], references: [id], onDelete: Restrict, map: "GBCategoryRepair_predefinedBenefit_fkey")
  occurrenceEvidence                  GlobalBenefitCategoryRepairOccurrence[]

  @@index([userId, phase], map: "GBCategoryRepair_user_phase_idx")
  @@index([creditCardId, phase], map: "GBCategoryRepair_card_phase_idx")
  @@index([predefinedBenefitId, phase], map: "GBCategoryRepair_benefit_phase_idx")
}

model GlobalBenefitCategoryRepairOccurrence {
  id                                     String                                  @id @default(cuid())
  repairId                               String
  userId                                 String
  creditCardId                           String
  predefinedBenefitId                    String
  targetPredefinedBenefitCatalogKey      String
  action                                 GlobalBenefitCategoryRepairAction
  keeperSource                           GlobalBenefitCategoryRepairStatusSource
  keeperStatusId                         String                                  @unique(map: "GBCategoryRepairOccurrence_keeperStatus_key")
  cycleStartDate                         DateTime
  cycleEndDate                           DateTime
  occurrenceIndex                        Int
  keeperBaselineVersion                  Int                                     @default(1)
  keeperBaseline                         Json
  removedStatusId                        String?                                 @unique(map: "GBCategoryRepairOccurrence_removedStatus_key")
  removedStatusSource                    GlobalBenefitCategoryRepairStatusSource?
  removedStatusPreimageVersion           Int?
  removedStatusPreimage                  Json?
  repairAddedAuditMetadataVersion        Int                                     @default(1)
  repairAddedAuditMetadata               Json
  planFingerprint                        String
  postimageFingerprint                   String
  createdAt                              DateTime                                @default(now())
  updatedAt                              DateTime                                @updatedAt
  repair                                 GlobalBenefitCategoryRepair             @relation(fields: [repairId], references: [id], onDelete: Cascade, map: "GBCategoryRepairOccurrence_repair_fkey")
  user                                   User                                    @relation("CategoryRepairOccurrenceOwner", fields: [userId], references: [id], onDelete: Cascade, map: "GBCategoryRepairOccurrence_user_fkey")
  creditCard                             CreditCard                              @relation("CategoryRepairOccurrenceCreditCard", fields: [creditCardId], references: [id], onDelete: Cascade, map: "GBCategoryRepairOccurrence_card_fkey")
  predefinedBenefit                      PredefinedBenefit                       @relation("CategoryRepairOccurrencePredefinedBenefit", fields: [predefinedBenefitId], references: [id], onDelete: Restrict, map: "GBCategoryRepairOccurrence_benefit_fkey")
  keeperStatus                           BenefitStatus                           @relation("CategoryRepairKeeperStatus", fields: [keeperStatusId], references: [id], onDelete: Cascade, map: "GBCategoryRepairOccurrence_keeperStatus_fkey")

  @@unique([repairId, userId, creditCardId, predefinedBenefitId, cycleStartDate, cycleEndDate, occurrenceIndex], map: "GBCategoryRepairOccurrence_tuple_key")
  @@index([repairId], map: "GBCategoryRepairOccurrence_repair_idx")
  @@index([userId, creditCardId], map: "GBCategoryRepairOccurrence_owner_card_idx")
  @@index([predefinedBenefitId, cycleStartDate], map: "GBCategoryRepairOccurrence_target_cycle_idx")
}

model playing_with_neon {
  id    Int    @id @default(autoincrement())
  name  String
  value Float? @db.Real
}

model LoyaltyProgram {
  id                   String             @id @default(cuid())
  name                 String             @unique
  displayName          String
  type                 LoyaltyProgramType
  company              String
  expirationMonths     Int?
  hasExpiration        Boolean            @default(true)
  /// ACTIVITY = last activity resets timer; EARNING = miles expire X months from earning (user enters oldest batch date)
  expirationBasis      String?            @default("ACTIVITY")
  website              String?
  logoUrl              String?
  description          String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  qualifyingActivities String?
  userAccounts         LoyaltyAccount[]
}

model LoyaltyAccount {
  id               String               @id @default(cuid())
  userId           String
  loyaltyProgramId String
  accountNumber    String?
  pointsBalance    Int?
  lastActivityDate DateTime
  expirationDate   DateTime?
  isActive         Boolean              @default(true)
  notes            String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  certificates     LoyaltyCertificate[]
  loyaltyProgram   LoyaltyProgram       @relation(fields: [loyaltyProgramId], references: [id], onDelete: Cascade)
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, loyaltyProgramId])
}

model LoyaltyCertificate {
  id               String         @id @default(cuid())
  userId           String
  loyaltyAccountId String
  label            String?
  quantity         Int            @default(1)
  expirationDate   DateTime
  notes            String?
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  loyaltyAccount   LoyaltyAccount @relation(fields: [loyaltyAccountId], references: [id], onDelete: Cascade)
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expirationDate])
  @@index([loyaltyAccountId, expirationDate])
}

model EmailVerificationToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model PasswordResetToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

enum BenefitFrequency {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
  ONE_TIME
}

enum BenefitCycleAlignment {
  CARD_ANNIVERSARY
  CALENDAR_FIXED
}

enum CardLifecycleStatus {
  ACTIVE
  CLOSED
  PRODUCT_CHANGED
}

enum CardEventType {
  OPENED
  ANNUAL_FEE
  RETENTION
  PRODUCT_CHANGE
  CLOSED
  SIGNUP_BONUS
  SPEND_DEADLINE
  NOTE
}

enum LoyaltyProgramType {
  AIRLINE
  HOTEL
  RENTAL_CAR
  CREDIT_CARD
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum SubscriptionTier {
  FREE
  PRO
}

enum ExternalSyncSource {
  AMEX
}

enum ExternalCardMappingKind {
  MANUAL_CONFIRMED
}

enum AmexSyncAttemptMode {
  WRITE
}

enum AmexSyncAttemptState {
  PROCESSING
  COMPLETED
  PARTIAL_FAILED
}

enum AmexSyncDisposition {
  UPDATED
  UNCHANGED
  SKIPPED
  FAILED
}

enum CatalogMigrationClassification {
  STANDARD
  CUSTOM
}

enum CatalogMigrationPhase {
  CLASSIFIED
  BRIDGED
  CLEANED
  ROLLED_BACK
}

enum GlobalBenefitCategoryRepairPhase {
  APPLIED
  ROLLED_BACK
}

enum GlobalBenefitCategoryRepairAction {
  PROMOTE_LEGACY_STATUS
  RETAIN_CANONICAL_STATUS
}

enum GlobalBenefitCategoryRepairStatusSource {
  LEGACY_CUSTOM
  CANONICAL_STANDARD
}
