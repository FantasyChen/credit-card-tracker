{
  "name": "perks-reminder",
  "version": "0.1.0",
  "description": "A smart credit card benefits tracking application that helps you maximize your rewards and never miss valuable perks",
  "type": "module",
  "keywords": [
    "credit-cards",
    "benefits",
    "tracking",
    "rewards",
    "next.js",
    "react"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lifan-builds/perks-reminder.git"
  },
  "homepage": "https://github.com/lifan-builds/perks-reminder#readme",
  "bugs": {
    "url": "https://github.com/lifan-builds/perks-reminder/issues"
  },
  "scripts": {
    "dev": "next dev",
    "dev:devdb": "node scripts/with-dev-db.js next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "db:seed": "prisma db seed",
    "check:public-db": "node scripts/check-public-db-invariant.cjs",
    "check:public-build:no-db": "node scripts/check-public-build-without-db.cjs",
    "card-template:validate": "node scripts/validate-card-template.cjs",
    "check:catalog-sync-workflow": "node scripts/check-catalog-sync-workflow.mjs",
    "build:amex-userscript": "node scripts/build-amex-benefit-reader.mjs",
    "build:amex-userscript:local": "node scripts/build-amex-benefit-reader.mjs local",
    "check:amex-userscripts": "node scripts/check-amex-userscript-artifacts.mjs",
    "build:amex-reader-extension": "node scripts/build-amex-reader-extension.mjs",
    "check:amex-reader-extension": "node scripts/check-amex-reader-extension.mjs",
    "test:e2e:amex": "npm run build:amex-userscript && npm run build:amex-userscript:local && playwright test --config playwright.amex.config.ts",
    "test:e2e:amex:visual": "npm run build:amex-userscript && npm run build:amex-userscript:local && AMEX_READER_E2E_VISUAL=1 playwright test --config playwright.amex.config.ts --headed --grep @visual",
    "usage-guides:audit": "node scripts/audit-usage-guide-links.cjs",
    "backfill:amex-catalog": "tsx scripts/backfill-amex-catalog-keys.ts",
    "sync:global-catalog": "tsx scripts/sync-global-catalog.ts",
    "migrate:global-benefits": "tsx scripts/migrate-global-benefits.ts",
    "repair:global-benefit-categories": "tsx scripts/repair-global-benefit-categories.ts",
    "verify:global-benefit-category-repair-parity": "tsx scripts/verify-global-benefit-category-repair-parity.ts",
    "rehearse:global-benefit-category-repair:dev": "tsx scripts/rehearse-global-benefit-category-repair-development.ts",
    "clone:amex-user:dev": "tsx scripts/clone-amex-user-to-development.ts",
    "postinstall": "prisma generate",
    "db:check": "node scripts/check-database-connection.js",
    "db:dev:migrate": "node scripts/with-dev-db.js npx prisma migrate deploy",
    "db:dev:status": "node scripts/with-dev-db.js npx prisma migrate status",
    "db:dev:seed": "node scripts/with-dev-db.js npx prisma db seed",
    "db:dev:reset": "node scripts/with-dev-db.js npx prisma migrate reset",
    "db:prod:status": "npx prisma migrate status",
    "db:prod:migrate": "npx prisma migrate deploy",
    "check:production-release": "node scripts/verify-production-release.mjs",
    "migrate:diff": "npx prisma migrate diff --from-migrations ./prisma/migrations --to-schema-datamodel ./prisma/schema.prisma",
    "ios:sync": "cap sync ios",
    "ios:open": "cap open ios"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@capacitor/core": "^8.3.4",
    "@heroicons/react": "^2.2.0",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-slot": "^1.2.2",
    "@vercel/analytics": "^1.5.0",
    "axios": "^1.19.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.6.1",
    "geist": "^1.3.1",
    "lucide-react": "^0.510.0",
    "next": "^15.5.23",
    "next-auth": "^4.24.15",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^4.5.1",
    "serpapi": "^2.1.0",
    "tailwind-merge": "^3.3.0",
    "yargs": "^17.7.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.4",
    "@capacitor/ios": "^8.3.4",
    "@eslint/eslintrc": "^3",
    "@next/swc-wasm-nodejs": "^15.5.23",
    "@playwright/test": "^1.61.1",
    "@prisma/nextjs-monorepo-workaround-plugin": "^6.7.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "0.25.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.23",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "ts-jest": "^29.3.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.3",
    "tw-animate-css": "^1.2.9",
    "typescript": "^5.8.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
